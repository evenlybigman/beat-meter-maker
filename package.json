{
  "name": "beat-meter-maker",
  "version": "0.1.0",
  "description": "비트 동기화 리듬 영상 편집기",
  "author": "Juke",
  "license": "GPL-3.0-or-later",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vite build && playwright test",
    "check": "tsc --noEmit && vite build && playwright test && playwright test -c playwright.electron.config.js",
    "app": "vite build && electron .",
    "test:app": "vite build && playwright test -c playwright.electron.config.js",
    "dist": "vite build && electron-builder"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^6.4.6",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "main": "electron/main.js",
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "build": {
    "appId": "com.beatmetermaker.app",
    "productName": "Beat Meter Maker",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "LICENSE"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.video"
    },
    "linux": {
      "target": "AppImage",
      "category": "Video"
    },
    "copyright": "Copyright (C) 2026 Juke",
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "publish": null
  }
}
